# ---------------------------------------------------------------------------
# 4 Bros Food Square — backend environment
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# Absolute or relative path to the SQLite database file.
DATABASE_FILE=./data/app.db

# ---------------------------------------------------------------------------
# Secrets — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. The server refuses to boot in production
# without strong, distinct values.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32-chars

# Token lifetimes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------------------
# CORS — comma separated list of allowed browser origins.
# In production this must list your real frontend domain(s), e.g.
# CORS_ORIGINS=https://www.example.com,https://example.com
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to `true` when the API is served over HTTPS behind a proxy (Render, Fly,
# Railway, nginx). Required for Secure cookies to work.
TRUST_PROXY=false

# Cookie settings. Use SameSite=none only when the frontend is on a different
# site than the API (e.g. Netlify frontend + separate API host) AND both are
# served over HTTPS.
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=3145728

# Public base URL of the API, used to build absolute image URLs.
PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Seed / bootstrap admin account (development + first deploy only).
# Change the password immediately after the first login in production.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=ChangeMe!2024
SEED_ADMIN_NAME=Restaurant Owner
