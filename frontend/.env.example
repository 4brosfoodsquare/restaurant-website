# ---------------------------------------------------------------------------
# 4 Bros Food Square — frontend build-time environment
# Copy to `.env` only if you need to override the default. Not required for
# local development (Vite's dev proxy handles it) or for a production build
# where the backend is reverse-proxied under the same domain as this site.
# ---------------------------------------------------------------------------

# Absolute URL of the backend API, only needed when the frontend and backend
# are deployed on different domains (e.g. frontend on Netlify, backend on
# Render/Fly/Railway). No trailing slash.
# VITE_API_URL=https://api.yourdomain.com
